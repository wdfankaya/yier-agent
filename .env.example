# OpenAI API Key
OPENAI_API_KEY=sk-xxx

# API 代理地址（可选，默认为 OpenAI 官方地址）
OPENAI_BASE_URL=https://api.openai.com/v1

# 模型配置
MODEL_NAME=gpt-4o-mini
TEMPERATURE=0.7

# MCP 配置
MCP_ENABLED=false
MCP_SERVER_URL=http://127.0.0.1:9123/mcp

# Multi-Agent 配置
MULTI_AGENT_ENABLED=false

# Memory 配置
MEMORY_ENABLED=true
MEMORY_DIR=app/sessions/memory
MEMORY_USER_ID=default
MAX_LTM_FACTS=50
# 每 N 轮后台巩固一次长期记忆（0=只在 close 时巩固）
LTM_CONSOLIDATE_EVERY=3

# Skill 配置
SKILLS_ENABLED=true
SKILLS_DIR=app/agent/skills/definitions

# Evaluation 配置（离线评估工具）
EVAL_DATASET_PATH=app/evaluation/cases.json
EVAL_USE_JUDGE=true
EVAL_PASS_THRESHOLD=0.6

# RAG 配置
# Embedding 专用 API 配置（可选，留空则复用 OPENAI_API_KEY / OPENAI_BASE_URL）。
# DeepSeek 等无 embedding 能力的供应商需单独配置，如硅基流动 https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
KB_DIR=app/agent/rag/knowledge
# 向量后端：numpy（手写余弦，便于调试）/ chroma（向量数据库，支持持久化）
RAG_BACKEND=numpy
# NumpyBackend 索引文件
KB_INDEX_PATH=app/sessions/kb_index.json
# ChromaBackend 持久化目录 + collection
CHROMA_PERSIST_DIR=app/sessions/chroma
# 召回 top-10 后用 bge-reranker-v2-m3 重排取 top-3。
# 与 embedding 是否同厂无关。key/url 留空则复用 EMBEDDING_*。
# 失败自动回落召回原序，不挡检索。
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_RECALL_K=10
RERANK_API_KEY=
RERANK_BASE_URL=

# PostgreSQL 落库（服务端开，CLI/离线 eval 可关）
DB_ENABLED=false
DATABASE_URL=postgresql+asyncpg://postgres:change_me@127.0.0.1:5432/yier_agent

# Redis 冷读缓存（进程重启回源加速；挂了自动回源 PG，服务不挂）
# docker run -d --name yier-redis -p 6379:6379 redis:7
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
SESSION_CACHE_TTL=1800

# HTTP 令牌桶（按 user_id）；LLM 超时/重试；工具超时
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_BURST=10
LLM_TIMEOUT=60
TOOL_TIMEOUT=10
LLM_MAX_RETRIES=3
LLM_RETRY_BASE=1

# 敏感操作 HITL（apply_refund 需用户确认）。评估沙箱会强制关掉。
HITL_ENABLED=true

